```{=html}
<div class="lecture-collection list">
<% for (const item of items) { %>
  <article class="lecture-card">
    <div class="lecture-card-art">
      <span class="lecture-index">LECTURE <%= String(item.order || 1).padStart(2, '0') %></span>
      <% if (item.image) { %><img src="<%= item.image %>" alt="" loading="lazy"><% } %>
    </div>
    <div class="lecture-card-copy">
      <p class="eyebrow"><%= (item.categories || []).join(' · ') %></p>
      <h3><a href="<%= item.path %>"><%= item.title %></a></h3>
      <p><%= item.description %></p>
      <div class="lecture-meta"><% if (item['reading-time-label']) { %><span><%= item['reading-time-label'] %> read</span><% } %><% if (item['slide-count']) { %><span><%= item['slide-count'] %> slides</span><% } %></div>
      <div class="card-links"><a class="button primary" href="<%= item.path %>">Read the notes <span aria-hidden="true">↗</span></a><a class="text-link" href="<%= item.path.replace(/index\.(qmd|html)$/, '') %>slides.html">Open slides <span aria-hidden="true">→</span></a></div>
    </div>
  </article>
<% } %>
</div>
```
